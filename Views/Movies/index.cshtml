@model List<ConsumoApi.Models.Movie>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">CineTrends</h1>
        <p class="lead text-secondary">Os filmes mais populares da semana</p>
        <hr class="w-25 mx-auto">
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var filme in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <partial name="_MovieCard" model="filme" />
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center py-5">
                    <i class="bi bi-search display-1"></i>
                    <p class="mt-3">Nenhum filme disponível no momento. Verifique sua conexão ou Chave de API.</p>
                </div>
            </div>
        }
    </div>
</div>