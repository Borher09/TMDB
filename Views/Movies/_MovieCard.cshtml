@model ConsumoApi.Models.Movie

<div class="card h-100 shadow-sm border-0 transition-hover">
    <img src="@Model.FullPosterUrl" 
         alt="@Model.Titulo" 
         class="card-img-top" 
         onerror="this.src='https://placehold.co/500x750?text=Sem+Imagem'" />

    <div class="card-body d-flex flex-column">
        <h6 class="card-title fw-bold">@Model.Titulo</h6>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            <span class="badge bg-warning text-dark"> @Model.Nota.ToString("F1")</span>
            <small class="text-muted">@Model.DataLancamento.Split('-')[0]</small>
        </div>
    </div>
</div>